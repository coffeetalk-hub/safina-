# Copy to .env for local work. On Railway, set these as service variables instead.

# ── Required ──
DATABASE_URL="postgresql://safina:safina@localhost:5433/safina"
# Any long random string: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
# Public address of the app, used for sign-in redirects and links in emails.
AUTH_URL="http://localhost:3000"
# Protects /api/cron/*. Background jobs do not run without it. Generate the same way as AUTH_SECRET.
CRON_SECRET=""
# Where attachments and logos live. On Railway: /data/storage (the attached volume).
STORAGE_DIR="./storage"

# ── Email: set one provider ──
# Railway blocks SMTP below the Pro plan, so an HTTPS provider is the safe choice.
RESEND_API_KEY=""
EMAIL_FROM="Safina ERP <no-reply@example.com>"
# SMTP alternative (Railway Pro plan or other hosts):
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# ── First deployment only: creates the first super admin when the database has no users ──
# Remove the password variable after signing in for the first time.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_COMPANY_CODE="MAIN"
BOOTSTRAP_COMPANY_NAME_AR=""
BOOTSTRAP_COMPANY_NAME_EN=""
BOOTSTRAP_COMPANY_VAT=""

# ── Optional ──
# Loads demo data with published passwords on every start. Throwaway demos only.
# ALLOW_DEMO_SEED="true"
# Turns off the built-in job scheduler, e.g. when an external cron calls /api/cron/tick.
# DISABLE_SCHEDULER="true"
