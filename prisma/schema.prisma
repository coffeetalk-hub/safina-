// Safina ERP — Prisma schema
// Conventions: every business table has companyId, soft-delete (deletedAt/deletedById),
// and audit stamps (createdById/updatedById). Money is Decimal(18,4).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────────── Foundation: tenancy ─────────────────────────────

model Company {
  id            String   @id @default(cuid())
  code          String   @unique
  nameAr        String
  nameEn        String
  crNumber      String?
  vatNumber     String?
  addressAr     String?
  addressEn     String?
  city          String?
  country       String   @default("SA")
  phone         String?
  email         String?
  website       String?
  logoKey       String?
  baseCurrency  String   @default("SAR")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  branches          Branch[]
  fiscalYears       FiscalYear[]
  userCompanies     UserCompany[]
  roles             Role[]
  currencies        CompanyCurrency[]
  taxCodes          TaxCode[]
  sequences         DocumentSequence[]
  approvalPolicies  ApprovalPolicy[]
  approvalRequests  ApprovalRequest[]
  accounts          Account[]
  accountMappings   AccountMapping[]
  costCenters       CostCenter[]
  customers         Customer[]
  vendors           Vendor[]
  items             Item[]
  employees         Employee[]
  settings          CompanySetting[]
  attachments       Attachment[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  emailOutbox       EmailOutbox[]
  dashboards        RoleDashboard[]
}

model Branch {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  code      String
  nameAr    String
  nameEn    String
  addressAr String?
  addressEn String?
  phone     String?
  isMain    Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdById String?
  updatedById String?
  deletedAt DateTime?
  deletedById String?

  employees Employee[]
  journalEntries JournalEntry[]

  @@unique([companyId, code])
  @@index([companyId])
}

model FiscalYear {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  code      String   // e.g. "2026"
  name      String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  status    FiscalStatus @default(OPEN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdById String?
  updatedById String?
  deletedAt DateTime?
  deletedById String?

  periods   FiscalPeriod[]

  @@unique([companyId, code])
}

model FiscalPeriod {
  id           String   @id @default(cuid())
  fiscalYearId String
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId], references: [id])
  companyId    String
  number       Int
  name         String
  startDate    DateTime @db.Date
  endDate      DateTime @db.Date
  status       FiscalStatus @default(OPEN)
  isAdjustment Boolean  @default(false)

  journalEntries JournalEntry[]

  @@unique([fiscalYearId, number])
  @@index([companyId, startDate, endDate])
}

enum FiscalStatus {
  OPEN
  CLOSED
  LOCKED
}

model Currency {
  code      String  @id // ISO 4217
  nameAr    String
  nameEn    String
  symbol    String?
  decimals  Int     @default(2)
  companies CompanyCurrency[]
  rates     ExchangeRate[]
}

model CompanyCurrency {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  currencyCode String
  currency     Currency @relation(fields: [currencyCode], references: [code])
  isActive     Boolean  @default(true)

  @@unique([companyId, currencyCode])
}

model ExchangeRate {
  id           String   @id @default(cuid())
  companyId    String
  currencyCode String
  currency     Currency @relation(fields: [currencyCode], references: [code])
  rateDate     DateTime @db.Date
  rate         Decimal  @db.Decimal(18, 8) // 1 unit of currency = rate SAR
  source       String?
  createdAt    DateTime @default(now())
  createdById  String?

  @@unique([companyId, currencyCode, rateDate])
}

model TaxCode {
  id          String      @id @default(cuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id])
  code        String
  nameAr      String
  nameEn      String
  category    TaxCategory
  rate        Decimal     @db.Decimal(5, 2) // percent
  isDefault   Boolean     @default(false)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  deletedById String?

  items       Item[]
  invoiceLines InvoiceLine[]
  billLines    BillLine[]

  @@unique([companyId, code])
}

enum TaxCategory {
  STANDARD
  ZERO_RATED
  EXEMPT
  OUT_OF_SCOPE
}

// ───────────────────────────── Foundation: auth & RBAC ─────────────────────────────

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  nameAr          String
  nameEn          String
  phone           String?
  locale          String    @default("ar")
  isActive        Boolean   @default(true)
  isSuperAdmin    Boolean   @default(false)
  failedLogins    Int       @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  defaultCompanyId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  companies       UserCompany[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  tablePrefs      UserTablePreference[]
  approvalActions ApprovalAction[]
}

model UserCompany {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  isDefault Boolean  @default(false)
  roles     UserCompanyRole[]

  @@unique([userId, companyId])
}

model Role {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  code        String
  nameAr      String
  nameEn      String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  permissions RolePermission[]
  users       UserCompanyRole[]
  policySteps ApprovalPolicyStep[]
  dashboards  RoleDashboard[]

  @@unique([companyId, code])
}

model UserCompanyRole {
  id            String      @id @default(cuid())
  userCompanyId String
  userCompany   UserCompany @relation(fields: [userCompanyId], references: [id], onDelete: Cascade)
  roleId        String
  role          Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userCompanyId, roleId])
}

/// Permission key format: "<module>.<resource>:<action>" e.g. "finance.invoice:approve"
model RolePermission {
  id         String @id @default(cuid())
  roleId     String
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission String

  @@unique([roleId, permission])
}

model UserTablePreference {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tableKey String
  columns  Json   // { visible: string[], order?: string[] }
  pageSize Int    @default(20)

  @@unique([userId, tableKey])
}

// ───────────────────────────── Foundation: audit ─────────────────────────────

model AuditLog {
  id         String      @id @default(cuid())
  companyId  String?
  company    Company?    @relation(fields: [companyId], references: [id])
  userId     String?
  user       User?       @relation(fields: [userId], references: [id])
  entity     String      // Prisma model name
  entityId   String
  action     AuditAction
  before     Json?
  after      Json?
  diff       Json?       // { field: { from, to } }
  ip         String?
  userAgent  String?
  at         DateTime    @default(now())

  @@index([companyId, entity, entityId])
  @@index([companyId, at])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  POST
  REVERSE
}

// ───────────────────────────── Foundation: numbering ─────────────────────────────

model DocumentSequence {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  docType     String   // e.g. "INVOICE", "JOURNAL", "PO"
  prefix      String   // e.g. "INV"
  pattern     String   @default("{PREFIX}-{YYYY}-{SEQ:4}")
  resetPolicy SequenceReset @default(YEARLY)
  periodKey   String   @default("") // e.g. "2026" when YEARLY, "" when NEVER
  nextNumber  Int      @default(1)
  updatedAt   DateTime @updatedAt

  @@unique([companyId, docType, periodKey])
}

enum SequenceReset {
  NEVER
  YEARLY
  MONTHLY
}

// ───────────────────────────── Foundation: approvals ─────────────────────────────

model ApprovalPolicy {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  docType     String
  nameAr      String
  nameEn      String
  minAmount   Decimal  @default(0) @db.Decimal(18, 4)
  maxAmount   Decimal? @db.Decimal(18, 4) // null = no upper bound
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  steps       ApprovalPolicyStep[]
  requests    ApprovalRequest[]

  @@index([companyId, docType])
}

model ApprovalPolicyStep {
  id         String         @id @default(cuid())
  policyId   String
  policy     ApprovalPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  order      Int
  roleId     String?
  role       Role?          @relation(fields: [roleId], references: [id])
  userId     String?        // specific approver
  nameAr     String
  nameEn     String

  @@unique([policyId, order])
}

model ApprovalRequest {
  id          String         @id @default(cuid())
  companyId   String
  company     Company        @relation(fields: [companyId], references: [id])
  policyId    String?
  policy      ApprovalPolicy? @relation(fields: [policyId], references: [id])
  docType     String
  docId       String
  docNumber   String?
  amount      Decimal        @default(0) @db.Decimal(18, 4)
  currentStep Int            @default(1)
  totalSteps  Int
  status      ApprovalStatus @default(PENDING)
  requestedById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  actions     ApprovalAction[]

  @@index([companyId, docType, docId])
  @@index([companyId, status])
}

model ApprovalAction {
  id         String         @id @default(cuid())
  requestId  String
  request    ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  step       Int
  userId     String
  user       User           @relation(fields: [userId], references: [id])
  decision   ApprovalStatus
  comment    String?
  at         DateTime       @default(now())
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ───────────────────────────── Foundation: master data ─────────────────────────────

model Account {
  id          String      @id @default(cuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id])
  code        String
  nameAr      String
  nameEn      String
  type        AccountType
  parentId    String?
  parent      Account?    @relation("AccountTree", fields: [parentId], references: [id])
  children    Account[]   @relation("AccountTree")
  level       Int         @default(1)
  isPostable  Boolean     @default(true)
  isControl   Boolean     @default(false) // AR/AP/bank control accounts
  isActive    Boolean     @default(true)
  currencyCode String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  deletedById String?

  mappings    AccountMapping[]
  customers   Customer[] @relation("CustomerReceivable")
  vendors     Vendor[]   @relation("VendorPayable")
  itemsRevenue Item[]    @relation("ItemRevenue")
  itemsExpense Item[]    @relation("ItemExpense")
  journalLines JournalLine[]
  bankAccounts BankAccount[]
  budgetLines  BudgetLine[]

  @@unique([companyId, code])
  @@index([companyId, type])
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

/// Control-account mapping keys used by the posting engine (AR, AP, VAT_INPUT, VAT_OUTPUT, ...)
model AccountMapping {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  key       String
  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  @@unique([companyId, key])
}

model CostCenter {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  code        String
  nameAr      String
  nameEn      String
  parentId    String?
  parent      CostCenter?  @relation("CostCenterTree", fields: [parentId], references: [id])
  children    CostCenter[] @relation("CostCenterTree")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  deletedById String?

  employees   Employee[]
  journalLines JournalLine[]
  budgetLines  BudgetLine[]

  @@unique([companyId, code])
}

model Customer {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  code          String
  nameAr        String
  nameEn        String
  type          PartyType @default(COMPANY)
  vatNumber     String?
  crNumber      String?
  email         String?
  phone         String?
  mobile        String?
  addressAr     String?
  addressEn     String?
  city          String?
  country       String   @default("SA")
  buildingNo    String?
  district      String?
  postalCode    String?
  contactPerson String?
  paymentTermsDays Int   @default(30)
  currencyCode  String   @default("SAR")
  receivableAccountId String?
  receivableAccount   Account? @relation("CustomerReceivable", fields: [receivableAccountId], references: [id])
  creditLimit   Decimal  @default(0) @db.Decimal(18, 4)
  blockOnCreditExceed Boolean @default(true)
  priceListId   String?
  salespersonId String?
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String?
  updatedById   String?
  deletedAt     DateTime?
  deletedById   String?

  invoices      CustomerInvoice[]
  receipts      Receipt[]
  opportunities Opportunity[]
  quotations    Quotation[]
  salesOrders   SalesOrder[]
  itemPrices    CustomerItemPrice[]
  portalUsers   PortalUser[]

  @@unique([companyId, code])
  @@index([companyId, nameEn])
}

model Vendor {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  code          String
  nameAr        String
  nameEn        String
  type          PartyType @default(COMPANY)
  vatNumber     String?
  crNumber      String?
  email         String?
  phone         String?
  mobile        String?
  addressAr     String?
  addressEn     String?
  city          String?
  country       String   @default("SA")
  contactPerson String?
  paymentTermsDays Int   @default(30)
  currencyCode  String   @default("SAR")
  payableAccountId String?
  payableAccount   Account? @relation("VendorPayable", fields: [payableAccountId], references: [id])
  bankName      String?
  iban          String?
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String?
  updatedById   String?
  deletedAt     DateTime?
  deletedById   String?

  bills         VendorBill[]
  payments      Payment[]
  rfqQuotes     RfqVendorQuote[]
  purchaseOrders PurchaseOrder[]
  contracts     VendorContract[]
  evaluations   VendorEvaluation[]

  @@unique([companyId, code])
  @@index([companyId, nameEn])
}

enum PartyType {
  COMPANY
  INDIVIDUAL
  GOVERNMENT
}

/// Non-stock items and services only (no quantities on hand).
model Item {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  code        String
  nameAr      String
  nameEn      String
  descriptionAr String?
  descriptionEn String?
  type        ItemType @default(SERVICE)
  unit        String   @default("EA")
  salePrice   Decimal  @default(0) @db.Decimal(18, 4)
  costPrice   Decimal  @default(0) @db.Decimal(18, 4)
  taxCodeId   String?
  taxCode     TaxCode? @relation(fields: [taxCodeId], references: [id])
  revenueAccountId String?
  revenueAccount   Account? @relation("ItemRevenue", fields: [revenueAccountId], references: [id])
  expenseAccountId String?
  expenseAccount   Account? @relation("ItemExpense", fields: [expenseAccountId], references: [id])
  isSellable  Boolean  @default(true)
  isPurchasable Boolean @default(true)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  deletedById String?

  invoiceLines InvoiceLine[]
  billLines    BillLine[]
  priceListItems PriceListItem[]
  customerPrices CustomerItemPrice[]

  @@unique([companyId, code])
}

enum ItemType {
  SERVICE
  NON_STOCK
}

model Employee {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  branchId      String?
  branch        Branch?  @relation(fields: [branchId], references: [id])
  costCenterId  String?
  costCenter    CostCenter? @relation(fields: [costCenterId], references: [id])
  userId        String?  @unique
  code          String
  firstNameAr   String
  lastNameAr    String
  firstNameEn   String
  lastNameEn    String
  gender        Gender   @default(MALE)
  nationality   String   @default("SA")
  isSaudi       Boolean  @default(true)
  nationalId    String?  // National ID / Iqama number
  dateOfBirth   DateTime? @db.Date
  maritalStatus String?
  religion      String?
  email         String?
  phone         String?
  addressAr     String?
  addressEn     String?
  jobTitleAr    String?
  jobTitleEn    String?
  department    String?
  managerId     String?
  manager       Employee?  @relation("EmployeeManager", fields: [managerId], references: [id])
  reports       Employee[] @relation("EmployeeManager")
  hireDate      DateTime? @db.Date
  terminationDate DateTime? @db.Date
  status        EmployeeStatus @default(ACTIVE)
  bankName      String?
  iban          String?
  gosiNumber    String?
  photoKey      String?
  isSalesperson Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String?
  updatedById   String?
  deletedAt     DateTime?
  deletedById   String?

  @@unique([companyId, code])
}

enum Gender {
  MALE
  FEMALE
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

// ───────────────────────────── Foundation: settings, files, notifications ─────────────────────────────

model CompanySetting {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  key       String
  value     Json

  @@unique([companyId, key])
}

model Attachment {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  entityType  String
  entityId    String
  fileName    String
  mimeType    String
  size        Int
  storageKey  String
  sha256      String?
  description String?
  uploadedById String?
  createdAt   DateTime @default(now())
  deletedAt   DateTime?
  deletedById String?

  @@index([companyId, entityType, entityId])
}

model Notification {
  id         String   @id @default(cuid())
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String   // e.g. APPROVAL_REQUESTED, DOCUMENT_EXPIRING
  titleAr    String
  titleEn    String
  bodyAr     String?
  bodyEn     String?
  link       String?
  entityType String?
  entityId   String?
  isRead     Boolean  @default(false)
  readAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([userId, isRead, createdAt])
}

model EmailOutbox {
  id          String   @id @default(cuid())
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  to          String
  subject     String
  html        String
  status      EmailStatus @default(PENDING)
  attempts    Int      @default(0)
  lastError   String?
  sentAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([status, createdAt])
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

model RoleDashboard {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  roleId    String
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  widgets   Json    // string[] widget keys in order

  @@unique([companyId, roleId])
}

/// Audit trail for Excel imports
model ImportJob {
  id          String   @id @default(cuid())
  companyId   String
  entityType  String
  fileName    String
  totalRows   Int
  successRows Int
  errorRows   Int
  errors      Json?
  createdById String?
  createdAt   DateTime @default(now())
}

// ═════════════════════════════ Finance ═════════════════════════════

enum DocStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  POSTED
  PARTIALLY_PAID
  PAID
  CANCELLED
  REVERSED
}

enum JournalSource {
  MANUAL
  RECURRING
  OPENING
  AR_INVOICE
  AR_RECEIPT
  AP_BILL
  AP_PAYMENT
  BANK
  PETTY_CASH
  ASSET
  PAYROLL
  CLOSING
}

model JournalEntry {
  id           String        @id @default(cuid())
  companyId    String
  branchId     String?
  branch       Branch?       @relation(fields: [branchId], references: [id])
  periodId     String
  period       FiscalPeriod  @relation(fields: [periodId], references: [id])
  number       String
  entryDate    DateTime      @db.Date
  description  String?
  reference    String?
  status       DocStatus     @default(DRAFT)
  source       JournalSource @default(MANUAL)
  sourceType   String?
  sourceId     String?
  currencyCode String        @default("SAR")
  exchangeRate Decimal       @default(1) @db.Decimal(18, 8)
  totalDebit   Decimal       @default(0) @db.Decimal(18, 4)
  totalCredit  Decimal       @default(0) @db.Decimal(18, 4)
  reversalOfId String?       @unique
  reversalOf   JournalEntry? @relation("Reversal", fields: [reversalOfId], references: [id])
  reversedBy   JournalEntry? @relation("Reversal")
  recurringId  String?
  recurring    RecurringJournal? @relation(fields: [recurringId], references: [id])
  postedAt     DateTime?
  postedById   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  createdById  String?
  updatedById  String?
  deletedAt    DateTime?
  deletedById  String?

  lines        JournalLine[]
  bankLines    BankStatementLine[]

  @@unique([companyId, number])
  @@index([companyId, entryDate])
  @@index([companyId, sourceType, sourceId])
  @@index([companyId, status])
}

model JournalLine {
  id           String       @id @default(cuid())
  entryId      String
  entry        JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  companyId    String
  lineNo       Int
  accountId    String
  account      Account      @relation(fields: [accountId], references: [id])
  costCenterId String?
  costCenter   CostCenter?  @relation(fields: [costCenterId], references: [id])
  description  String?
  debit        Decimal      @default(0) @db.Decimal(18, 4)
  credit       Decimal      @default(0) @db.Decimal(18, 4)
  baseDebit    Decimal      @default(0) @db.Decimal(18, 4)
  baseCredit   Decimal      @default(0) @db.Decimal(18, 4)
