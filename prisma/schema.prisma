  employeeId      String
  number          String
  terminationDate DateTime @db.Date
  reason          EosReason @default(RESIGNATION)
  serviceYears    Decimal  @db.Decimal(8, 4)
  monthlyWage     Decimal  @db.Decimal(18, 4) // EOSB wage basis
  fullEntitlement Decimal  @db.Decimal(18, 4) // Art. 84 before Art. 85 reduction
  eosbPct         Int      @default(100)
  eosbAmount      Decimal  @db.Decimal(18, 4)
  leaveDays       Decimal  @default(0) @db.Decimal(6, 2)
  leaveEncashment Decimal  @default(0) @db.Decimal(18, 4)
  otherAdditions  Decimal  @default(0) @db.Decimal(18, 4)
  otherDeductions Decimal  @default(0) @db.Decimal(18, 4)
  loanBalance     Decimal  @default(0) @db.Decimal(18, 4)
  netAmount       Decimal  @db.Decimal(18, 4)
  status          EosStatus @default(DRAFT)
  journalEntryId  String?
  paymentEntryId  String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdById     String?
  updatedById     String?
  @@unique([companyId, number])
}
