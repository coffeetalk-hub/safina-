  @@index([companyId, customerId])
  @@index([companyId, status])
  @@index([companyId, invoiceDate])
}

model InvoiceLine {
  id               String          @id @default(cuid())
  invoiceId        String
  invoice          CustomerInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  lineNo           Int
  itemId           String?
  item             Item?           @relation(fields: [itemId], references: [id])
  descriptionAr    String
  descriptionEn    String
  quantity         Decimal         @default(1) @db.Decimal(18, 4)
  unitPrice        Decimal         @default(0) @db.Decimal(18, 4)
  discountPct      Decimal         @default(0) @db.Decimal(5, 2)
  discountAmount   Decimal         @default(0) @db.Decimal(18, 4)
  taxCodeId        String?
  taxCode          TaxCode?        @relation(fields: [taxCodeId], references: [id])
  taxRate          Decimal         @default(0) @db.Decimal(5, 2)
  net              Decimal         @default(0) @db.Decimal(18, 4)
  tax              Decimal         @default(0) @db.Decimal(18, 4)
  total            Decimal         @default(0) @db.Decimal(18, 4)
  revenueAccountId String?
  costCenterId     String?
}

model ZatcaDocument {
  id           String          @id @default(cuid())
  invoiceId    String          @unique
  invoice      CustomerInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  companyId    String
  uuid         String          @unique
