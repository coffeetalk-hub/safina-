/** Company-level HR rules (effective-dated via updatedAt; values are editable, not hard-coded). */
model HrSettings {
  id                 String  @id @default(cuid())
  companyId          String  @unique
  workStart          String  @default("08:00")
  workEnd            String  @default("17:00")
  dailyHours         Decimal @default(8) @db.Decimal(5, 2)
  weekendDays        String  @default("FRI,SAT") // comma list of MON..SUN
  graceMinutes       Int     @default(10)
  overtimeMultiplier Decimal @default(1.5) @db.Decimal(4, 2)
  daysPerMonth       Int     @default(30)   // daily wage divisor (Labour Law practice)
  annualLeaveDays    Int     @default(21)   // Art. 109
  annualLeaveDaysAfter5y Int @default(30)
  sickFullPayDays    Int     @default(30)   // Art. 117: 30 days 100 %
  sickPartialPayDays Int     @default(60)   // then 60 days 75 %
  sickPartialPayPct  Int     @default(75)
  sickUnpaidDays     Int     @default(30)   // then 30 days unpaid
  eosbWageBasis      String  @default("BASIC_HOUSING") // BASIC | BASIC_HOUSING | FULL
  gosiWageBasis      String  @default("BASIC_HOUSING") // BASIC | BASIC_HOUSING | FULL
  gosiMinWage        Decimal @default(1500) @db.Decimal(18, 4)
  gosiMaxWage        Decimal @default(45000) @db.Decimal(18, 4)
  wpsEstablishmentId String?
  wpsBankCode        String?
  payDay             Int     @default(27)
  updatedAt          DateTime @updatedAt
  updatedById        String?
}

