  discountPct    Decimal     @default(0) @db.Decimal(5, 2)
  taxTotal       Decimal     @default(0) @db.Decimal(18, 4)
  total          Decimal     @default(0) @db.Decimal(18, 4)
  baseTotal      Decimal     @default(0) @db.Decimal(18, 4)
  paidAmount     Decimal     @default(0) @db.Decimal(18, 4)
  status         DocStatus   @default(DRAFT)
  reference      String?
  notes          String?
